{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "IdentityDb": "mongodb://identity-db:27017"
  },
  "ApiEndpoints": {
    "Account": "http://account:8080/api/v1/account/"
  },
  "Jwt": {
    "Secret": "super-secret-key-change-in-production-32chars!!",
    "Issuer": "eventus-identity",
    "Audience": "eventus-services",
    "ExpiryMinutes": "60"
  }
}
